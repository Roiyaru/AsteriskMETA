diff -ruN a/hev-socks5-tunnel/src/hev-socks5-session.c b/hev-socks5-tunnel/src/hev-socks5-session.c
--- a/hev-socks5-tunnel/src/hev-socks5-session.c	2026-11-11 19:41:55.800155900 +0800
+++ b/hev-socks5-tunnel/src/hev-socks5-session.c	2026-11-11 19:42:41.592205500 +0800
@@ -8,6 +8,9 @@
  */
 
 #include <string.h>
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <arpa/inet.h>
 
 #include "hev-utils.h"
 #include "hev-logger.h"
@@ -131,11 +134,46 @@
 int
 hev_socks5_session_bind (HevSocks5 *self, int fd, const struct sockaddr *dest)
 {
+    HevSocks5Client *cli = HEV_SOCKS5_CLIENT (self);
     HevConfigServer *srv;
     unsigned int mark;
 
     LOG_D ("%p socks5 session bind", self);
 
+    if (cli->bind_port)
+    {
+        struct sockaddr_storage bsaddr;
+        socklen_t bslen;
+        int one = 1;
+
+        memset (&bsaddr, 0, sizeof (bsaddr));
+        if (dest->sa_family == AF_INET6)
+        {
+            struct sockaddr_in6 *sin6 = (struct sockaddr_in6 *)&bsaddr;
+            sin6->sin6_family = AF_INET6;
+            sin6->sin6_port = cli->bind_port;
+            sin6->sin6_addr = in6addr_loopback;
+            bslen = sizeof (struct sockaddr_in6);
+        }
+        else
+        {
+            struct sockaddr_in *sin = (struct sockaddr_in *)&bsaddr;
+            sin->sin_family = AF_INET;
+            sin->sin_port = cli->bind_port;
+            sin->sin_addr.s_addr = htonl (INADDR_LOOPBACK);
+            bslen = sizeof (struct sockaddr_in);
+        }
+
+        setsockopt (fd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof (one));
+        setsockopt (fd, SOL_SOCKET, SO_REUSEPORT, &one, sizeof (one));
+        if (bind (fd, (struct sockaddr *)&bsaddr, bslen) < 0)
+        {
+            /* Non-fatal: fall back to an ephemeral port. */
+            LOG_W ("%p socks5 session bind src port %d", self,
+                   ntohs (cli->bind_port));
+        }
+    }
+
     srv = hev_config_get_socks5_server ();
     mark = srv->mark;
 
